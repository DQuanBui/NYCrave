# Copy to .env.local. Every key is optional in Phase 1; the app runs on local seed data.

# Canonical site origin for metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps (Phase 2): MapLibre + OpenStreetMap tiles by default; set to use Mapbox tiles instead
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Places API (Phase 5): photos, hours, reviews. Server-side only, never exposed.
GOOGLE_PLACES_API_KEY=

# Supabase (Phase 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Design My Day LLM enhancement (Phase 4B). Server-side only.
ANTHROPIC_API_KEY=
