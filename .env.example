# Copy to .env.local. Every key is optional; without them the app runs on local seed data.

# Canonical site origin for metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps use MapLibre + OpenFreeMap (OpenStreetMap) tiles by default; set to use Mapbox tiles
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Places API (New): photos, ratings, reviews and hours import. Server-side only.
GOOGLE_PLACES_API_KEY=

# Supabase: when set, places are read from Postgres instead of data/*.json.
# The service role key enables admin writes; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Turns on the "Ask NYCrave" assistant and Design My Day's "Refine with AI" button.
# Server-side only; both are hidden when unset. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: the model the assistant uses (defaults to claude-sonnet-5).
ASSISTANT_MODEL=

# Password for /admin (add, edit and verify places). Admin is disabled when unset.
ADMIN_PASSWORD=
